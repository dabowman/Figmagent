{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(.claude/worktrees/**)",
      "Write(.claude/worktrees/**)",
      "Bash(bun scripts/dispatch-fix.ts *)"
    ],
    "deny": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(.claude/commands/**)",
      "Write(.claude/commands/**)",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Read(~/.ssh/**)",
      "Read(~/.figmagent/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Edit(.claude/worktrees/**/.github/**)",
      "Write(.claude/worktrees/**/.github/**)",
      "Edit(.claude/worktrees/**/scripts/**)",
      "Write(.claude/worktrees/**/scripts/**)",
      "Edit(.claude/worktrees/**/.claude/**)",
      "Write(.claude/worktrees/**/.claude/**)",
      "Edit(.claude/worktrees/**/.claude-plugin/**)",
      "Write(.claude/worktrees/**/.claude-plugin/**)",
      "Edit(.claude/worktrees/**/package.json)",
      "Write(.claude/worktrees/**/package.json)",
      "Edit(.claude/worktrees/**/bun.lock)",
      "Write(.claude/worktrees/**/bun.lock)",
      "Edit(.claude/worktrees/**/src/figma_plugin/manifest.json)",
      "Write(.claude/worktrees/**/src/figma_plugin/manifest.json)",
      "Edit(.claude/worktrees/**/.mcp.json)",
      "Write(.claude/worktrees/**/.mcp.json)",
      "Edit(.claude/worktrees/**/CLAUDE.md)",
      "Write(.claude/worktrees/**/CLAUDE.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [".", "~/.bun/install/cache"],
      "denyRead": ["~/.ssh", "~/.figmagent", "~/.aws", "~/.claude/*.json"]
    },
    "network": {
      "allowedDomains": ["api.github.com", "github.com", "registry.npmjs.org"]
    }
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1200000"
  }
}
