node_modules/
.cursor/
.env
dist/
docs/
# .mcp.json is tracked as the plugin's MCP manifest (uses ${CLAUDE_PLUGIN_ROOT}).
# .cursor/mcp.json (machine-specific absolute paths from setup.sh) stays ignored via .cursor/ above.
.claude/transcripts/
.claude/sessions-json/
# Ephemeral git worktrees created by the auto-improve Stage D (/dispatch-fixes)
# and by background agents. Full repo copies, each with its own biome.json — the
# lint/check/format scripts scope to `src tests` so these never trip Biome's
# "nested root configuration" scan.
.claude/worktrees/
.DS_Store
# Generated by bun build:plugin from src/figma_plugin/src/
src/figma_plugin/code.js

# launchd stdout/stderr capture (machine-specific; the pipeline writes its own log)
.claude/analysis/auto-improve.launchd.log

# Auto-improve pipeline state (machine-local): the run lock, the circuit
# breaker (delete it — or `bun scripts/pipeline-record.ts resume` — to resume),
# and the guard hook's denial log. The run record (pipeline-runs.jsonl) IS tracked.
.pipeline.lock
.pipeline.paused
.claude/analysis/pipeline-guard.log
